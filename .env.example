# ReasonFlow — PostgreSQL-first configuration (copy to .env and adjust).
# SQLite is NOT a runtime option: PostgreSQL 16 + pgvector is the canonical store.

# Canonical database (docker compose service host is `postgres`; local dev uses localhost)
DATABASE_URL=postgresql+psycopg://reasonflow:reasonflow@postgres:5432/reasonflow

# Redis (semantic cache + login limiter); absent ⇒ in-process fallbacks, logged degraded
REDIS_URL=redis://redis:6379/0

# Secrets — set a real key outside local dev
APP_SECRET_KEY=change-me-in-production

# Demo/deterministic mode (LLM credentials OPTIONAL: absent ⇒ deterministic
# templates compute every number; "offline AI mode" still runs on PostgreSQL)
DEMO_MODE=1
SEED_ON_BOOT=1

# Optional LLM credentials (leave unset for deterministic mode)
# OPENAI_API_KEY=
# EMBEDDING_API_KEY=
